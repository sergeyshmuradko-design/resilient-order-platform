# База, которую создаёт official postgres image при первом старте.
POSTGRES_DB=orders_db
POSTGRES_USER=orders_user
POSTGRES_PASSWORD=change-me

# Local Vault dev root token.
# In real environments applications should not use a root token.
VAULT_DEV_ROOT_TOKEN_ID=local-dev-root-token

# Read-only monitoring role для postgres-exporter.
POSTGRES_EXPORTER_USER=postgres_exporter
POSTGRES_EXPORTER_PASSWORD=change-me

# Owner запускает Flyway и владеет объектами schema order_service.
# App user используется order-service в runtime.
ORDER_SERVICE_DB_OWNER_USER=order_service_owner
ORDER_SERVICE_DB_OWNER_PASSWORD=change-me
ORDER_SERVICE_DB_USER=order_service_app
ORDER_SERVICE_DB_PASSWORD=change-me

# Owner запускает Flyway и владеет объектами schema notification_service.
# App user используется notification-service в runtime.
NOTIFICATION_SERVICE_DB_OWNER_USER=notification_service_owner
NOTIFICATION_SERVICE_DB_OWNER_PASSWORD=change-me
NOTIFICATION_SERVICE_DB_USER=notification_service_app
NOTIFICATION_SERVICE_DB_PASSWORD=change-me

# JWT signing key for local development.
# Generate a value with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long

# RabbitMQ administrator used only for local broker bootstrap and UI access.
RABBITMQ_ADMIN_USERNAME=admin
RABBITMQ_ADMIN_PASSWORD=change-me

# RabbitMQ application users used by the broker definitions managed through
# Helm + External Secrets Operator. Applications should not use the admin user.
ORDER_SERVICE_RABBITMQ_USERNAME=order_service_app
ORDER_SERVICE_RABBITMQ_PASSWORD=change-me
NOTIFICATION_SERVICE_RABBITMQ_USERNAME=notification_service_app
NOTIFICATION_SERVICE_RABBITMQ_PASSWORD=change-me

# Grafana local-development administrator.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Local bootstrap user for order-service authentication.
# Temporary local setup until an external authorization server is added.
ORDER_SERVICE_ADMIN_USERNAME=admin
ORDER_SERVICE_ADMIN_PASSWORD=change-me

# Local regular user for order-service authentication.
ORDER_SERVICE_USER_USERNAME=user
ORDER_SERVICE_USER_PASSWORD=change-me
